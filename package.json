{
  "name": "stellar-dino",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:game && NEXT_PUBLIC_GAME_AVAILABLE=1 next build",
    "start": "next start",
    "lint": "eslint",
    "test:contracts": "cd contracts && cargo test",
    "test:testnet": "tsx --conditions=react-server --env-file=.env.local scripts/e2e-testnet.ts",
    "build:game": "npm --prefix dino-game ci --omit=dev && npm --prefix dino-game run build && rm -rf public/game && mkdir -p public && cp -R dino-game/dist public/game",
    "test:agent": "tsx --conditions=react-server --env-file=.env.local scripts/agent-demo.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.1.0",
    "@supabase/supabase-js": "^2.117.2",
    "exifr": "^7.1.3",
    "leaflet": "^1.9.4",
    "next": "16.3.6",
    "openai": "^7.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "sharp": "^0.35.4",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vercel": "^60.0.1"
  }
}
